{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "storybook-spa": {
      "type": "http",
      "url": "http://localhost:6006/mcp"
    },
    "storybook-ssr": {
      "type": "http",
      "url": "http://localhost:6007/mcp"
    }
  }
}
