{
  "name": "@reactloom/library-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate.mjs && vite --host 127.0.0.1 --port 4319",
    "build": "node scripts/generate.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4319",
    "catalog:generate": "node scripts/generate.mjs",
    "catalog:check": "node scripts/generate.mjs --check",
    "lint": "biome check src scripts tests e2e package.json tsconfig.json vite.config.ts playwright.config.ts",
    "typecheck": "node scripts/generate.mjs && tsc --noEmit",
    "test": "node --test tests/catalog.test.mjs tests/generate.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:setup": "playwright install chromium",
    "test:sdk": "node --test tests/sdk.test.mjs"
  },
  "dependencies": {
    "@radix-ui/react-tabs": "1.1.13",
    "@tanstack/react-router": "1.170.42",
    "clsx": "2.1.1",
    "p-limit": "7.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "6.1.6",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "rehype-sanitize": "6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
