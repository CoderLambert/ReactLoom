        "rollup-plugin-istanbul": "^4.0.0",
        "rollup-plugin-swc3": "^0.7.0",
        "rollup-plugin-terser": "^7.0.2",
        "typescript": "^4.7.4",
        "yargs": "^17.5.1"
      },
