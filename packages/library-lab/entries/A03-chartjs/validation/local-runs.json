    {
      "label": "metadata",
      "cwd": "/home/lambert/githubRepos/lambert/ReactLoom/packages/library-lab",
      "argv": [
        "node",
        "--input-type=module",
        "-e",
        "import assert from 'node:assert/strict';import {readFile,stat} from 'node:fs/promises';import {createHash} from 'node:crypto';import {validateEntry} from './src/lib/catalog.mjs';import {entryCompletenessIssues} from './scripts/entry-gate.mjs';const root='entries/A03-chartjs/';const e=JSON.parse(await readFile(root+'library.json','utf8'));assert.deepEqual(validateEntry(e),[]);assert.deepEqual(entryCompletenessIssues(e,{guide:true,agent:true,agents:true,verification:true}),[]);assert.deepEqual(e.demos.map(d=>d.level),['basic','business','advanced']);const sources=new Set(e.demos.flatMap(d=>d.sourceFiles));assert.equal(sources.size,5);for(const f of sources)assert.ok((await stat(root+f)).isFile(),f);const raw=await readFile(root+e.official.readme.snapshotPath);assert.equal(createHash('sha256').update(raw).digest('hex'),e.official.readme.sha256);assert.equal(raw.length,2605);assert.equal(e.official.readme.commit,'76d8cf895a7485dc838c90ef37e2bc9d9e388fcb');const ev=JSON.parse(await readFile(root+'official/source-evidence.json','utf8'));assert.equal(ev.package.data.version,'4.6.1');assert.equal(ev.tree.data.truncated,false);assert.deepEqual(ev.tree.data.readmeCandidates,['README.md']);assert.equal(e.official.homepage.status,'unknown');const v=JSON.parse(await readFile(root+'verification.json','utf8'));assert.ok(Object.values(v).every(x=>x.status==='NOT_RUN'));console.log('A03 shape/completeness, three goals/five migration files, exact official version/README bytes/hash and formal NOT_RUN: PASS');"
