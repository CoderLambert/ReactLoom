      "argv": [
        "node",
        "--input-type=module",
        "-e",
        "import assert from 'node:assert/strict';import {createRequire} from 'node:module';import {fileURLToPath} from 'node:url';import {readFileSync,existsSync} from 'node:fs';import {dirname,join} from 'node:path';import {createHash} from 'node:crypto';\nconst d3Entry=fileURLToPath(import.meta.resolve('d3'));const require=createRequire(d3Entry);const sha=b=>createHash('sha256').update(b).digest('hex');\nconst modules=[['d3',d3Entry,'7.9.0',/d3-selection|d3-transition/],...Object.entries({'d3-selection':['3.0.1',/function bindKey|function selection_join|function selection_on/],'d3-scale':['4.0.3',/function band|function linear/],'d3-axis':['3.0.1',/function axis\\(|function axisBottom|axis.tickValues/],'d3-shape':['3.2.1',/function line\\(|function slope3|function MonotoneX|line.defined/],'d3-transition':['3.0.2',/selection.prototype.interrupt|function selection_interrupt/]}).map(([name,[version,pattern]])=>[name,require.resolve(name),version,pattern])];\nconst output={checkedAt:new Date().toISOString(),node:process.version,modules:[]};\nfor(const [name,source,version,pattern]of modules){let dir=dirname(source);while(!existsSync(join(dir,'package.json')))dir=dirname(dir);const raw=readFileSync(join(dir,'package.json'));const pkg=JSON.parse(raw);assert.equal(pkg.name,name);assert.equal(pkg.version,version);const bytes=readFileSync(source);const lines=bytes.toString().split('\\n');const evidence=lines.flatMap((text,index)=>pattern.test(text)?[{line:index+1,text:text.slice(0,300)}]:[]);assert.ok(evidence.length,name);output.modules.push({name,version,source,sourceSha256:sha(bytes),packagePath:join(dir,'package.json'),packageSha256:sha(raw),evidence});}\nconst typesPackage='node_modules/@types/d3/package.json';const types=JSON.parse(readFileSync(typesPackage));assert.equal(types.version,'7.4.3');output.types={packagePath:typesPackage,name:types.name,version:types.version,indexSha256:sha(readFileSync('node_modules/@types/d3/index.d.ts'))};console.log(JSON.stringify(output,null,2));"
