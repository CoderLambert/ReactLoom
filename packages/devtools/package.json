{
  "name": "@reactloom/devtools",
  "version": "0.1.0",
  "private": true,
  "description": "Dev-only helpers. Nothing here should be imported from a production entry.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stack": {
      "types": "./dist/stack.d.ts",
      "import": "./dist/stack.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@reactloom/tsconfig": "workspace:*",
    "@types/node": "22.20.5",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/ui": "5.0.3",
    "jsdom": "30.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
