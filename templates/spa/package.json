{
  "name": "@reactloom/template-spa",
  "version": "0.1.0",
  "private": true,
  "description": "ReactLoom production SPA template.",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4317",
    "build": "vite build && node scripts/check-bundle-budget.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4317",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "typecheck:affected": "pnpm --filter \"...[HEAD]\" --if-present typecheck",
    "test:affected": "pnpm --filter \"...[HEAD]\" --if-present test",
    "test:e2e:setup": "playwright install chromium",
    "test:e2e": "playwright test",
    "analyze": "ANALYZE=true vite build",
    "storybook": "STORYBOOK=true storybook dev -p 6006 --no-open",
    "build-storybook": "STORYBOOK=true storybook build"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@reactloom/api-client": "workspace:*",
    "@sentry/react": "11.6.0",
    "@t3-oss/env-core": "0.13.11",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-query-devtools": "5.104.1",
    "@tanstack/react-router": "1.170.42",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "26.4.3",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "6.1.6",
    "react-hook-form": "7.89.0",
    "react-i18next": "17.0.16",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@axe-core/react": "4.13.0",
    "@playwright/test": "1.64.0",
    "@reactloom/devtools": "workspace:*",
    "@reactloom/tsconfig": "workspace:*",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router-devtools": "1.167.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/ui": "5.0.3",
    "axe-core": "4.14.0",
    "code-inspector-plugin": "2.0.9",
    "jsdom": "30.1.2",
    "msw": "3.0.3",
    "msw-storybook-addon": "3.0.3",
    "react-scan": "0.5.7",
    "rollup-plugin-visualizer": "7.1.1",
    "storybook": "10.6.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-checker": "0.14.5",
    "vitest": "5.0.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
