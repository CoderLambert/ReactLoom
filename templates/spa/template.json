{
  "id": "spa",
  "description": "Vite SPA with TanStack Router, TanStack Query, and a session-guarded feature.",
  "strip": ["template.json"],
  "packages": {
    "api-client": true,
    "devtools": true,
    "tsconfig": ["base.json", "react.json", "vite.json", "node.json"]
  },
  "configs": [
    ".npmrc",
    ".editorconfig",
    "biome.json",
    "lefthook.yml",
    "commitlint.config.mjs",
    ".changeset/config.json",
    ".changeset/README.md",
    "renovate.json",
    "scripts/open-in-editor.mjs",
    "scripts/code",
    "scripts/code.cmd"
  ],
  "ci": ".github/workflows/ci.yml",
  "docker": false,
  "ai": {
    "pointers": ["CLAUDE.md", ".github/copilot-instructions.md", ".cursor/mcp.json"],
    "rules": ["general.mdc", "spa.mdc", "testing.mdc"]
  },
  "reactScan": {
    "package": "react-scan",
    "version": "0.5.7",
    "enabled": true,
    "config": "src/main.tsx"
  },
  "whyDidYouRender": {
    "package": "@welldone-software/why-did-you-render",
    "version": "10.0.1",
    "enabled": false,
    "config": "AGENTS.md",
    "reason": "why-did-you-render v10 needs its package as the automatic JSX importSource. Vite 8 injects that import before React, which runs ahead of React Scan, so this template does not load why-did-you-render. React Scan's outline shows the render cause and the props that changed."
  },
  "bundleAnalyze": {
    "package": "rollup-plugin-visualizer",
    "version": "7.1.1",
    "config": "vite.config.ts",
    "script": "ANALYZE=true vite build",
    "marker": "rollup-plugin-visualizer"
  },
  "propsDiff": {
    "primary": "react-scan",
    "hook": "@reactloom/devtools",
    "config": "src/main.tsx"
  },
  "storybook": {
    "enabled": true,
    "package": "storybook",
    "version": "10.6.1",
    "framework": "@storybook/react-vite",
    "config": ".storybook/main.ts",
    "stories": ["src/components/ui/button.stories.tsx", "src/features/auth/login-page.stories.tsx"]
  },
  "browserMocks": {
    "mode": "msw",
    "flag": "VITE_ENABLE_MSW",
    "config": "src/main.tsx",
    "package": "msw",
    "version": "3.0.3"
  },
  "devA11y": {
    "enabled": true,
    "package": "@axe-core/react",
    "version": "4.13.0",
    "config": "src/main.tsx"
  },
  "e2e": {
    "tool": "playwright",
    "config": "playwright.config.ts",
    "package": "@playwright/test",
    "version": "1.64.0"
  },
  "clickToSource": {
    "plugin": "code-inspector-plugin",
    "version": "2.0.9",
    "config": "vite.config.ts",
    "launchEditor": ".env.development",
    "launcher": "scripts/open-in-editor.mjs"
  },
  "docs": [
    "docs/adr/0003-sessions.md",
    "docs/adr/0004-api-client.md",
    "docs/adr/0005-tooling.md",
    "docs/adr/0006-ai-collaboration.md",
    "docs/getting-started.md"
  ]
}
