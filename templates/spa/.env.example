# Public client configuration. Copy to .env.local for machine-specific values.
# Do not put secrets in VITE_ variables; they are embedded in the bundle.
VITE_API_BASE_URL=http://127.0.0.1:4317
VITE_ENABLE_MSW=true
VITE_SENTRY_DSN=
VITE_APP_NAME=ReactLoom
# Query/Router 统一面板、axe 日志与点击跳源码；`.env.development` 将其设为 true。
# Playwright 会设为 false，且进程环境变量优先。
VITE_DEVTOOLS=true
# React Scan 默认关闭，可在统一面板开启；true 表示开发启动时自动扫描。
VITE_REACT_SCAN=false
# Optional editor override. Arguments and quotes are supported, for example: cursor --reuse-window
# LAUNCH_EDITOR=cursor
# REACTLOOM_EDITOR_DEBUG=1
# Set this to false to keep `pnpm dev` from opening a browser. CI does the same.
# REACTLOOM_OPEN=false
