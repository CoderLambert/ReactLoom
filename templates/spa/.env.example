# Public client configuration. Copy to .env.local for machine-specific values.
# Do not put secrets in VITE_ variables; they are embedded in the bundle.
VITE_API_BASE_URL=http://127.0.0.1:4317
VITE_ENABLE_MSW=true
VITE_SENTRY_DSN=
VITE_APP_NAME=ReactLoom
# Query, Router, React Scan, and click-to-source. Playwright sets this to false.
VITE_DEVTOOLS=true
# Editor for click-to-source. Put this in .env.local. code, cursor, webstorm, or an executable path.
# CODE_EDITOR=cursor
# LAUNCH_EDITOR is the Vite launch-editor name. REACT_EDITOR is the Next.js overlay name.
# The dev server uses the first of CODE_EDITOR, LAUNCH_EDITOR, REACT_EDITOR that is set.
