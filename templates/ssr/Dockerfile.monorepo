# Build from the ReactLoom repository root:
#   docker build -f templates/ssr/Dockerfile.monorepo -t reactloom-ssr .
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.33.3 --activate
WORKDIR /repo

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY packages ./packages
COPY templates/ssr/package.json ./templates/ssr/package.json
RUN pnpm install --frozen-lockfile --filter @reactloom/template-ssr...

FROM base AS build
COPY --from=deps /repo /repo
COPY packages ./packages
COPY templates/ssr ./templates/ssr
ENV REACTLOOM_STRICT_SECRETS=false
RUN pnpm --filter @reactloom/api-client build && pnpm --filter @reactloom/template-ssr build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
RUN addgroup -S nodejs && adduser -S nextjs -G nodejs
COPY --from=build /repo/templates/ssr/.next/standalone ./
COPY --from=build /repo/templates/ssr/.next/static ./templates/ssr/.next/static
COPY --from=build /repo/templates/ssr/public ./templates/ssr/public
USER nextjs
EXPOSE 3000
CMD ["node", "templates/ssr/server.js"]
