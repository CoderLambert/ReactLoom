{
  "extends": "@reactloom/tsconfig/next.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".storybook/**/*.ts",
    "next.config.ts",
    "src/proxy.ts"
  ],
  "exclude": ["node_modules"]
}
