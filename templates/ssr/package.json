{
  "name": "@reactloom/template-ssr",
  "version": "0.1.0",
  "private": true,
  "description": "ReactLoom production SSR template.",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "node scripts/run-project-tool.mjs dev",
    "prepare": "node scripts/prepare.mjs",
    "build": "next build && node scripts/check-bundle-budget.mjs",
    "start": "next start --hostname 0.0.0.0 --port 4318",
    "preview": "node scripts/run-project-tool.mjs preview",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && node --test scripts/prepare.test.mjs scripts/run-project-tool.test.mjs",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "typecheck:affected": "pnpm --filter \"...[HEAD]\" --if-present typecheck",
    "test:affected": "pnpm --filter \"...[HEAD]\" --if-present test",
    "test:e2e:setup": "playwright install chromium",
    "test:e2e": "playwright test",
    "analyze": "next analyze --output",
    "doctor:editor": "node scripts/run-project-tool.mjs doctor",
    "storybook": "node scripts/run-project-tool.mjs storybook",
    "build-storybook": "node scripts/run-project-tool.mjs build-storybook",
    "lighthouse": "pnpm build && lhci autorun"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@reactloom/api-client": "workspace:*",
    "@sentry/nextjs": "11.6.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-query": "5.104.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "26.4.3",
    "jose": "6.2.12",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-i18next": "17.0.16",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@axe-core/react": "4.13.0",
    "@next/bundle-analyzer": "16.4.0",
    "@playwright/test": "1.64.0",
    "@reactloom/devtools": "workspace:*",
    "@reactloom/tsconfig": "workspace:*",
    "@lhci/cli": "0.15.1",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-mcp": "10.6.1",
    "@storybook/nextjs": "10.6.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-query-devtools": "5.104.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/ui": "5.0.3",
    "code-inspector-plugin": "2.0.9",
    "msw": "3.0.3",
    "msw-storybook-addon": "3.0.3",
    "react-scan": "0.5.7",
    "storybook": "10.6.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
