{
  "id": "ssr",
  "description": "Next.js App Router template with cookie sessions, security headers, and Docker.",
  "strip": ["template.json", "Dockerfile.monorepo"],
  "rename": {
    "Dockerfile.standalone": "Dockerfile"
  },
  "replacements": [
    {
      "file": "next.config.ts",
      "from": "path.join(import.meta.dirname, '../..')",
      "to": "path.join(import.meta.dirname)"
    }
  ],
  "packages": {
    "api-client": true,
    "devtools": true,
    "tsconfig": ["base.json", "react.json", "next.json", "node.json"]
  },
  "configs": [
    ".npmrc",
    ".editorconfig",
    "biome.json",
    "lefthook.yml",
    "commitlint.config.mjs",
    ".changeset/config.json",
    ".changeset/README.md",
    "renovate.json",
    "turbo.json",
    "scripts/open-in-editor.mjs",
    "scripts/code",
    "scripts/code.cmd"
  ],
  "ci": ".github/workflows/ci.yml",
  "docker": true,
  "ai": {
    "pointers": ["CLAUDE.md", ".github/copilot-instructions.md", ".cursor/mcp.json"],
    "rules": ["general.mdc", "ssr.mdc", "testing.mdc"]
  },
  "reactScan": {
    "package": "react-scan",
    "version": "0.5.7",
    "enabled": true,
    "config": "src/app/react-scan.tsx"
  },
  "whyDidYouRender": {
    "package": "@welldone-software/why-did-you-render",
    "version": "10.0.1",
    "enabled": false,
    "config": "AGENTS.md",
    "reason": "Next.js 16 compiles JSX with SWC on Turbopack and has no app-wide jsxImportSource. why-did-you-render v10 requires that Babel setting, so this template does not load it. React Scan's outline shows the render cause and the props that changed."
  },
  "bundleAnalyze": {
    "package": "@next/bundle-analyzer",
    "version": "16.4.0",
    "config": "next.config.ts",
    "script": "next analyze --output",
    "marker": "@next/bundle-analyzer"
  },
  "propsDiff": {
    "primary": "react-scan",
    "hook": "@reactloom/devtools",
    "config": "src/app/react-scan.tsx"
  },
  "storybook": {
    "enabled": true,
    "package": "storybook",
    "version": "10.6.1",
    "framework": "@storybook/nextjs",
    "config": ".storybook/main.ts",
    "stories": ["src/components/ui/button.stories.tsx", "src/app/login/page.stories.tsx"]
  },
  "browserMocks": {
    "mode": "msw",
    "flag": "NEXT_PUBLIC_ENABLE_MSW",
    "config": "src/app/dev-client.tsx",
    "package": "msw",
    "version": "3.0.3"
  },
  "devA11y": {
    "enabled": true,
    "package": "@axe-core/react",
    "version": "4.13.0",
    "config": "src/app/dev-client.tsx"
  },
  "e2e": {
    "tool": "playwright",
    "config": "playwright.config.ts",
    "package": "@playwright/test",
    "version": "1.64.0"
  },
  "clickToSource": {
    "plugin": "code-inspector-plugin",
    "version": "2.0.9",
    "config": "next.config.ts",
    "launchEditor": ".env.development",
    "launcher": "scripts/open-in-editor.mjs"
  },
  "docs": [
    "docs/adr/0003-sessions.md",
    "docs/adr/0004-api-client.md",
    "docs/adr/0005-tooling.md",
    "docs/adr/0006-ai-collaboration.md",
    "docs/getting-started.md",
    "docs/best-practices/README.md",
    "docs/best-practices/components.md",
    "docs/best-practices/state.md",
    "docs/best-practices/data-fetching.md",
    "docs/best-practices/styling.md",
    "docs/best-practices/performance.md",
    "docs/best-practices/pitfalls.md",
    "docs/best-practices/workflow-research.md",
    "docs/best-practices/dev-tools.md",
    "docs/turborepo.md"
  ]
}
