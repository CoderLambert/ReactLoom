# Copy to .env.local. SESSION_SECRET must be a unique random string in any shared environment.
# Production always rejects the built-in development fallback, even without strict mode.
# REACTLOOM_STRICT_SECRETS=true also rejects it outside production.
SESSION_SECRET=
REACTLOOM_STRICT_SECRETS=false
NEXT_PUBLIC_APP_NAME=ReactLoom
# Query 统一面板、axe 日志与点击跳源码；`.env.development` 将其设为 true。
# Playwright 会设为 false，且进程环境变量优先。
NEXT_PUBLIC_DEVTOOLS=true
# React Scan 默认关闭，可在统一面板开启；true 表示开发启动时自动扫描。
NEXT_PUBLIC_REACT_SCAN=false
# Optional editor override for the Next.js overlay and click-to-source. Arguments and quotes work.
# LAUNCH_EDITOR=cursor
# REACTLOOM_EDITOR_DEBUG=1
# Set this to false to keep `pnpm dev` from opening a browser. CI does the same.
# REACTLOOM_OPEN=false
NEXT_PUBLIC_SENTRY_DSN=
# Opt-in browser mocks. Off by default so Playwright hits the route handlers.
# Set this to true in `.env.local` while `pnpm dev` is running.
NEXT_PUBLIC_ENABLE_MSW=false
