# Copy to .env.local. SESSION_SECRET must be a unique random string in any shared environment.
# The development fallback is rejected when REACTLOOM_STRICT_SECRETS=true.
SESSION_SECRET=
REACTLOOM_STRICT_SECRETS=false
NEXT_PUBLIC_APP_NAME=ReactLoom
# Query devtools, React Scan, and click-to-source. Playwright sets this to false.
NEXT_PUBLIC_DEVTOOLS=true
# Next.js error overlay and route DevTools open files with REACT_EDITOR, then VISUAL, then EDITOR.
# Click-to-source uses the first of CODE_EDITOR, LAUNCH_EDITOR, REACT_EDITOR that is set.
# REACT_EDITOR=cursor
NEXT_PUBLIC_SENTRY_DSN=
