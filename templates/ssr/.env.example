# Copy to .env.local. SESSION_SECRET must be a unique random string in any shared environment.
# The development fallback is rejected when REACTLOOM_STRICT_SECRETS=true.
SESSION_SECRET=
REACTLOOM_STRICT_SECRETS=false
NEXT_PUBLIC_APP_NAME=ReactLoom
# Query devtools, React Scan, and click-to-source. `.env.development` sets this to true.
# Playwright sets it to false and that process value wins.
NEXT_PUBLIC_DEVTOOLS=true
# Optional editor override for the Next.js overlay and click-to-source.
# Leave unset to detect Neovim ($NVIM or .nvim.sock), then Cursor or VS Code.
# REACT_EDITOR=cursor
# Set this to false to keep `pnpm dev` from opening a browser. CI does the same.
# REACTLOOM_OPEN=false
NEXT_PUBLIC_SENTRY_DSN=
# Opt-in browser mocks. Off by default so Playwright hits the route handlers.
# Set this to true in `.env.local` while `pnpm dev` is running.
NEXT_PUBLIC_ENABLE_MSW=false
