{
  "id": "mobile",
  "description": "Expo Router template with a secure-store session and the shared API client.",
  "strip": ["template.json"],
  "replacements": [
    {
      "file": "metro.config.js",
      "from": "path.resolve(projectRoot, '../..')",
      "to": "projectRoot"
    }
  ],
  "packages": {
    "api-client": true,
    "devtools": true,
    "tsconfig": ["base.json", "react.json", "expo.json", "node.json"]
  },
  "configs": [
    ".npmrc",
    ".editorconfig",
    "biome.json",
    "lefthook.yml",
    "commitlint.config.mjs",
    ".changeset/config.json",
    ".changeset/README.md",
    "renovate.json",
    "turbo.json",
    "scripts/open-in-editor.mjs",
    "scripts/code",
    "scripts/code.cmd"
  ],
  "ci": ".github/workflows/ci.yml",
  "docker": false,
  "ai": {
    "pointers": ["CLAUDE.md", ".github/copilot-instructions.md", ".cursor/mcp.json"],
    "rules": ["general.mdc", "mobile.mdc", "testing.mdc"]
  },
  "reactScan": {
    "package": "react-scan",
    "version": "0.5.7",
    "enabled": false,
    "config": "AGENTS.md",
    "reason": "react-scan 0.5.7 has no React Native export. The native preview at aidenybai/react-scan#23 is unmerged, so this template does not load React Scan."
  },
  "whyDidYouRender": {
    "package": "@welldone-software/why-did-you-render",
    "version": "10.0.1",
    "enabled": true,
    "config": "babel.config.js"
  },
  "bundleAnalyze": {
    "package": "expo-atlas",
    "version": "0.4.3",
    "config": "package.json",
    "script": "EXPO_ATLAS=true expo export --platform web --output-dir dist && expo-atlas .expo/atlas.jsonl",
    "marker": "EXPO_ATLAS"
  },
  "propsDiff": {
    "primary": "@welldone-software/why-did-you-render",
    "hook": "@reactloom/devtools",
    "config": "src/lib/wdyr.js"
  },
  "storybook": {
    "enabled": false,
    "package": "storybook",
    "version": "10.6.1",
    "framework": "@storybook/react-vite",
    "config": "AGENTS.md",
    "reason": "@storybook/react-native 10.6.0 is developed with Expo 57, but it requires react-native-safe-area-context 5.8.0 and @gorhom/bottom-sheet. Expo SDK 57 bundles safe-area-context ~5.7.0 and does not include bottom-sheet, so this template does not load on-device Storybook."
  },
  "browserMocks": {
    "mode": "fixtures",
    "flag": "EXPO_PUBLIC_USE_FIXTURES",
    "config": "AGENTS.md",
    "reason": "msw 3.0.3 ships a browser worker and a Node server, and no React Native entry. This template keeps local data behind EXPO_PUBLIC_USE_FIXTURES instead of loading MSW."
  },
  "devA11y": {
    "enabled": false,
    "package": "@axe-core/react",
    "version": "4.13.0",
    "config": "AGENTS.md",
    "reason": "@axe-core/react needs a DOM. This template renders React Native views, so it does not load that package. Use the axe DevTools browser extension on the web preview, and Maestro for the device flow."
  },
  "e2e": {
    "tool": "maestro",
    "config": ".maestro/login.yaml"
  },
  "clickToSource": {
    "plugin": "react-native-dev-inspector",
    "version": "1.1.0",
    "config": "metro.config.js",
    "launchEditor": ".env.development",
    "launcher": "scripts/open-in-editor.mjs"
  },
  "docs": [
    "docs/adr/0003-sessions.md",
    "docs/adr/0004-api-client.md",
    "docs/adr/0005-tooling.md",
    "docs/adr/0006-ai-collaboration.md",
    "docs/getting-started.md",
    "docs/best-practices/README.md",
    "docs/best-practices/components.md",
    "docs/best-practices/state.md",
    "docs/best-practices/data-fetching.md",
    "docs/best-practices/styling.md",
    "docs/best-practices/performance.md",
    "docs/best-practices/pitfalls.md",
    "docs/best-practices/workflow-research.md",
    "docs/best-practices/dev-tools.md",
    "docs/turborepo.md"
  ]
}
