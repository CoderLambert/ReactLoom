# Loaded by Expo during `pnpm dev`. Secrets stay in `.env.local`.
# Click-to-source is on. The launcher tries an explicit editor, then a Neovim
# server ($NVIM or .nvim.sock from `nvim --listen .nvim.sock`), then Cursor or
# VS Code. If nothing opens, uncomment the next line and restart Metro:
# LAUNCH_EDITOR=cursor
EXPO_PUBLIC_DEVTOOLS=true
