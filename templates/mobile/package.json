{
  "name": "@reactloom/template-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "ReactLoom production Expo template.",
  "main": "expo-router/entry",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export --platform web --output-dir dist",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@reactloom/api-client": "workspace:*",
    "@t3-oss/env-core": "0.13.11",
    "@tanstack/react-query": "5.104.1",
    "expo": "57.0.27",
    "expo-constants": "~57.0.21",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "@expo/log-box": "~57.0.4",
    "@expo/metro-runtime": "~57.0.16",
    "@hookform/resolvers": "5.9.1",
    "expo-status-bar": "~57.0.1",
    "i18next": "26.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.89.0",
    "react-i18next": "17.0.16",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "react-native-web": "~0.21.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@reactloom/tsconfig": "workspace:*",
    "@types/react": "19.3.0",
    "babel-preset-expo": "~57.0.14",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
