# Public Expo configuration. Copy to .env.local. Do not put secrets in EXPO_PUBLIC_ variables.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:4317
EXPO_PUBLIC_USE_FIXTURES=true
EXPO_PUBLIC_SENTRY_DSN=
# Click-to-source. `.env.development` sets this to true.
EXPO_PUBLIC_DEVTOOLS=true
# Optional editor override. Arguments and quotes are supported, for example: cursor --reuse-window
# LAUNCH_EDITOR=cursor
# REACTLOOM_EDITOR_DEBUG=1
