{
  "name": "reactloom",
  "private": true,
  "version": "0.1.0",
  "description": "ReactLoom production templates for SPA, SSR, and mobile React apps.",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev:spa": "pnpm --filter @reactloom/template-spa dev",
    "dev:ssr": "pnpm --filter @reactloom/template-ssr dev",
    "dev:mobile": "pnpm --filter @reactloom/template-mobile start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e:setup": "pnpm --filter @reactloom/template-spa --filter @reactloom/template-ssr test:e2e:setup",
    "test:e2e": "pnpm --filter @reactloom/template-spa --filter @reactloom/template-ssr test:e2e",
    "build": "pnpm -r build",
    "create-reactloom": "pnpm --filter create-reactloom build && node ./packages/create-reactloom/dist/cli.js",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "create-reactloom": "workspace:*",
    "lefthook": "2.2.1"
  }
}
