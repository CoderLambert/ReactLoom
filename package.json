{
  "name": "reactloom",
  "private": true,
  "version": "0.1.0",
  "description": "ReactLoom production templates for SPA, SSR, and mobile React apps.",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev:spa": "turbo run dev --ui=tui --filter=@reactloom/template-spa",
    "dev:ssr": "turbo run dev --ui=tui --filter=@reactloom/template-ssr",
    "dev:mobile": "turbo run dev --ui=tui --filter=@reactloom/template-mobile",
    "lint": "turbo run lint lint:root",
    "lint:root": "biome check scripts package.json biome.json lefthook.yml commitlint.config.mjs packages/tsconfig",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck:affected": "turbo run typecheck --affected",
    "test:affected": "turbo run test --affected",
    "test:e2e:setup": "pnpm --filter @reactloom/template-spa --filter @reactloom/template-ssr test:e2e:setup",
    "test:e2e": "turbo run test:e2e --filter=@reactloom/template-spa --filter=@reactloom/template-ssr",
    "build": "turbo run build",
    "analyze": "turbo run analyze",
    "doctor:editor": "node scripts/open-in-editor.mjs --doctor",
    "lighthouse": "turbo run lighthouse --filter=@reactloom/template-spa --filter=@reactloom/template-ssr",
    "prepare": "node scripts/setup-git.mjs",
    "create-reactloom": "pnpm --filter create-reactloom build && node ./packages/create-reactloom/dist/cli.js",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "dev:library": "turbo run dev --ui=tui --filter=@reactloom/library-lab",
    "build:library": "turbo run build --filter=@reactloom/library-lab",
    "test:library": "pnpm --filter @reactloom/library-lab test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "create-reactloom": "workspace:*",
    "lefthook": "2.2.1",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  }
}
